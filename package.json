{
  "name": "shanguo-vocab",
  "private": true,
  "version": "1.0.1",
  "author": "Pao-LL",
  "description": "ShanGuo word book",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win dir"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "build": {
    "appId": "com.pll.shanguo",
    "productName": "ShanGuo",
    "asar": false,
    "extraMetadata": { "type": "commonjs" },
    "directories": {
      "output": "C:/Users/PLL/ShanGuoDist",
      "buildResources": "build"
    },
    "files": ["dist/**/*", "electron/**/*", "build/icon.png", "build/icon.ico"],
    "win": {
      "icon": "build/icon.ico",
      "target": ["dir"],
      "artifactName": "ShanGuo-${version}.exe"
    }
  }
}
